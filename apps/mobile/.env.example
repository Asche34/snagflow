# Mobile app environment (apps/mobile). All EXPO_PUBLIC_ vars are inlined into
# the JS bundle, so they must contain no secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Base URL of the web app for report generation and deep links
EXPO_PUBLIC_API_BASE_URL=https://your-snagflow-web.example
# Local browser preview: use http://127.0.0.1:54321 and http://127.0.0.1:3003.
# A physical phone needs reachable LAN/HTTPS addresses, never its own localhost.
