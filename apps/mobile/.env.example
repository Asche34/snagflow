# Mobile app environment (apps/mobile). All EXPO_PUBLIC_ vars are inlined into
# the JS bundle, so they must contain no secrets.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL of the web app for report generation and deep links
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Expo push project id (from `eas init` or expo.dev account)
EXPO_PUBLIC_PROJECT_ID=
