# ---------------------------------------------------------------------------
# Root environment for `docker compose up` (the web container only).
#
# Copy to `.env` and fill the values from `supabase status -o env`.
# `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env
#   supabase start && supabase status -o env
# ---------------------------------------------------------------------------

# Supabase API as the *browser* sees it (inlined into the client bundle).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable / anon key. Public by design, but read it from the running stack
# rather than hardcoding it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the web app (used for redirects and links).
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Show the seeded demo accounts on the login screen (local development only).
NEXT_PUBLIC_DEMO_ACCOUNTS=1

# Server-side URL used from inside the container.
SUPABASE_SERVER_URL=http://host.docker.internal:54321

# Host port for the compose web service (maps to container port 3000).
# 3003 avoids clashing with another dev app that may already hold 3000 —
# E2E must be told about it: E2E_BASE_URL=http://localhost:3003
WEB_PORT=3003
